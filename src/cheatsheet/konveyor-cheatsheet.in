#!/usr/bin/env python3
import json
import os
import re
import signal
import subprocess
import sys
from pathlib import Path

import dbus

KGLOBALSHORTCUTS = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "kglobalshortcutsrc"
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
DATA_HOME = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share"))
QML = Path(os.environ.get("KONVEYOR_CHEATSHEET_QML", Path(__file__).resolve().parent.parent / "share" / "konveyor" / "cheatsheet" / "Cheatsheet.qml"))
VIEWER = Path(os.environ.get("KONVEYOR_CHEATSHEET_VIEWER", "@KDE_INSTALL_FULL_LIBEXECDIR@/konveyor-cheatsheet-viewer"))
PORTAL_LAUNCHER = Path.home() / ".local" / "bin" / "portal-launcher"
WIDGETS_SECTION = "Konveyor widgets"
GESTURES_SECTION = "Gestures"
LAUNCHER_GAMES_GROUP = "services][org.devl0rd.portal.launcher.games.desktop"
KONTROL_PANEL_GROUP = "konveyor-kontrol-panel"
PID_FILE = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "konveyor-cheatsheet.pid"

KONVEYOR_CATEGORIES = [
    ("Workspaces", re.compile(r"workspace")),
    ("Monitors", re.compile(r"monitor")),
    ("Floating & Tabs", re.compile(r"floating|tiling|tabbed|column-display")),
    ("Sizing", re.compile(r"width|height|maximize|fullscreen|expand|center")),
    ("Move Windows", re.compile(r"^(move|consume|expel|swap)")),
    ("Focus", re.compile(r"^focus")),
]

KDE_SECTIONS = {
    "kwin": "KDE Windows & Desktops",
    "plasmashell": "KDE Plasma",
    "ksmserver": "KDE Session",
    "mediacontrol": "KDE Media",
    "kmix": "KDE Volume",
    "org_kde_powerdevil": "KDE Power",
}

MODIFIER_ORDER = ["Meta", "Ctrl", "Alt", "Shift"]
MODIFIER_ALIASES = {"mod": "Meta", "super": "Meta", "win": "Meta", "meta": "Meta", "ctrl": "Ctrl", "control": "Ctrl", "alt": "Alt", "shift": "Shift"}
KEY_ALIASES = {"plus": "+", "page_down": "pgdown", "page_up": "pgup", "bracketleft": "[", "bracketright": "]", "comma": ",", "period": ".", "minus": "-", "equal": "=", "escape": "esc", "slash": "/"}


def split_key(text):
    return re.split(r"\+(?!$)", text)


def normalize_key(text):
    parts = split_key(text)
    modifiers = sorted({MODIFIER_ALIASES.get(part.lower(), part) for part in parts[:-1]}, key=lambda m: MODIFIER_ORDER.index(m) if m in MODIFIER_ORDER else 99)
    key = parts[-1].lower()
    return "+".join(modifiers + [KEY_ALIASES.get(key, key)])


def close_running():
    try:
        pid = int(PID_FILE.read_text().strip())
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
    except (FileNotFoundError, ValueError):
        PID_FILE.unlink(missing_ok=True)
        return False
    PID_FILE.unlink(missing_ok=True)
    if str(QML).encode() not in cmdline:
        return False
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return False
    return True


def konveyor_binds():
    interface = dbus.Interface(dbus.SessionBus().get_object("org.kde.Konveyor", "/Konveyor"), "org.kde.Konveyor")
    return json.loads(str(interface.Binds()))


def describe_konveyor_bind(bind):
    if bind.get("title"):
        return bind["title"]
    action = bind["action"]
    words = [action["name"].replace("-", " ").capitalize(), *action.get("arguments", [])]
    words += [f"{key}={value}" for key, value in action.get("properties", {}).items()]
    return " ".join(words)


def konveyor_gestures():
    interface = dbus.Interface(dbus.SessionBus().get_object("org.kde.Konveyor", "/Konveyor"), "org.kde.Konveyor")
    return json.loads(str(interface.Gestures()))


def gesture_entry(gesture):
    device = "touchpad" if gesture["device"] == "touchpad" else "touchscreen"
    fingers = gesture["fingers"]
    motion = gesture["motion"]
    if motion == "long-press":
        seconds = gesture["hold-ms"] / 1000
        return {"action": f"Move a window: hold its title bar on the {device}", "keys": [f"Hold {seconds:g} s+Drag"], "gesture": gesture}
    if motion == "tap":
        taps = {
            "cycle-width": "Cycle the column width",
            "kontrol-panel": "Open or close the Kontrol Panel",
            "toggle-overview": "Open or close the overview",
        }
        tap = taps.get(gesture["action"]) or gesture["action"].replace("-", " ").capitalize()
        return {"action": f"{tap} on the {device}", "keys": [f"{fingers} fingers tap"], "gesture": gesture}
    actions = {
        "swipe-horizontal": ("Scroll the row", "swipe ←→"),
        "swipe-vertical": ("Switch workspace", "swipe ↑↓"),
        "pinch": ("Open or close the overview", "pinch"),
        "window-swipe-horizontal": ("Merge the window into the next column, or pop it out", "swipe ←→"),
        "window-swipe-vertical": ("Move the window up or down, then to the next workspace", "swipe ↑↓"),
    }
    action, glyph = actions.get(motion) or (gesture["action"].replace("-", " ").capitalize(), motion.replace("-", " "))
    return {"action": f"{action} on the {device}", "keys": [f"{fingers} fingers {glyph}"], "gesture": gesture}


def konveyor_category(action_name):
    return next((name for name, pattern in KONVEYOR_CATEGORIES if pattern.search(action_name)), "Konveyor")


def numbered_group(bind):
    arguments = bind["action"].get("arguments", [])
    key = bind["key"]
    if len(arguments) == 1 and str(arguments[0]).isdigit() and key.endswith("+" + str(arguments[0])):
        return bind["action"]["name"], key[: -len(str(arguments[0]))]
    return None


def konveyor_sections(binds):
    sections = {}
    merged = {}
    numbered = {}
    for bind in binds:
        if bind.get("hidden"):
            continue
        name = bind["action"]["name"]
        group = numbered_group(bind)
        if group:
            numbered.setdefault(group, []).append(int(bind["action"]["arguments"][0]))
            continue
        action = describe_konveyor_bind(bind)
        entry = merged.get(action)
        if entry is None:
            entry = merged[action] = {"action": action, "keys": [], "id": name}
            sections.setdefault(konveyor_category(name), []).append(entry)
        entry["keys"].append(bind["key"])
    for (name, prefix), numbers in numbered.items():
        low, high = min(numbers), max(numbers)
        words = name.replace("-", " ").capitalize()
        sections.setdefault(konveyor_category(name), []).append({"action": f"{words} {low}–{high}", "keys": [f"{prefix}{low}…{high}"], "id": name})
    return sections


def split_shortcut_value(value):
    return re.split(r"(?<!\\),", value, maxsplit=2)


def shortcut_keys(value):
    keys = split_shortcut_value(value)[0].replace("\\t", "\t").split("\t")
    return [key.replace("\\,", ",") for key in keys if key and key != "none"]


def kde_entries(taken_keys):
    if not KGLOBALSHORTCUTS.exists():
        return
    group = None
    for line in KGLOBALSHORTCUTS.read_text().splitlines():
        header = re.fullmatch(r"\[(.+)\]", line)
        if header:
            group = header.group(1)
            continue
        if group == LAUNCHER_GAMES_GROUP and line.startswith("_launch="):
            keys = shortcut_keys(line.split("=", 1)[1])
            if keys:
                yield WIDGETS_SECTION, {"action": "Kontrol Panel: open on Games", "keys": keys}
            continue
        if group == KONTROL_PANEL_GROUP and line.startswith("toggle="):
            keys = shortcut_keys(line.split("=", 1)[1])
            if keys:
                yield WIDGETS_SECTION, {"action": "Kontrol Panel: open", "keys": keys}
            continue
        if group not in KDE_SECTIONS or "=" not in line or line.startswith("_k_"):
            continue
        fields = split_shortcut_value(line.split("=", 1)[1])
        if len(fields) < 3:
            continue
        keys = [key for key in shortcut_keys(fields[0]) if normalize_key(key) not in taken_keys]
        if keys:
            yield KDE_SECTIONS[group], {"action": fields[2], "keys": keys}


def widget_entries():
    if not (DATA_HOME / "plasma" / "plasmoids" / "org.devl0rd.portal.launcher").is_dir():
        return []
    return [{"action": "Kontrol Panel: jump to a page", "keys": ["Alt+1…8"]}]


def collapse_numbered(entries):
    groups = {}
    result = []
    for entry in entries:
        match = re.fullmatch(r"(.*\D)(\d+)", entry["action"])
        key = entry["keys"][0] if len(entry["keys"]) == 1 else ""
        if match and key.endswith(match.group(2)):
            stem = (match.group(1), key[: -len(match.group(2))], entry.get("id"))
            if stem not in groups:
                groups[stem] = {"entry": dict(entry), "numbers": []}
                result.append(groups[stem]["entry"])
            groups[stem]["numbers"].append(int(match.group(2)))
            continue
        result.append(entry)
    for (text, prefix, _), group in groups.items():
        low, high = min(group["numbers"]), max(group["numbers"])
        if low != high:
            group["entry"].update(action=f"{text}{low}–{high}", keys=[f"{prefix}{low}…{high}"])
    return result


def build_sections():
    binds = konveyor_binds()
    taken = {normalize_key(bind["key"]) for bind in binds}
    sections = konveyor_sections(binds)
    for gesture in konveyor_gestures():
        sections.setdefault(GESTURES_SECTION, []).append(gesture_entry(gesture))
    for entry in widget_entries():
        sections.setdefault(WIDGETS_SECTION, []).append(entry)
    for name, entry in kde_entries(taken):
        sections.setdefault(name, []).append(entry)
    sections = {name: collapse_numbered(entries) for name, entries in sections.items()}
    order = ["Focus", "Move Windows", "Sizing", "Workspaces", "Floating & Tabs", "Monitors", "Konveyor", GESTURES_SECTION, WIDGETS_SECTION] + list(KDE_SECTIONS.values())
    ordered = sorted(sections.items(), key=lambda item: order.index(item[0]) if item[0] in order else len(order))
    return [{"name": name, "entries": sorted(entries, key=lambda e: e["action"].lower())} for name, entries in ordered]


def notify(summary, message):
    try:
        notifications = dbus.Interface(dbus.SessionBus().get_object("org.freedesktop.Notifications", "/org/freedesktop/Notifications"), "org.freedesktop.Notifications")
        notifications.Notify("Konveyor", dbus.UInt32(0), "dialog-error", summary, message, dbus.Array([], signature="s"), dbus.Dictionary({}, signature="sv"), 10000)
    except dbus.exceptions.DBusException as error:
        sys.stderr.write(f"konveyor-cheatsheet: could not show a notification: {error.get_dbus_message()}\n")


def fail(message, show):
    sys.stderr.write(f"konveyor-cheatsheet: {message}\n")
    if show:
        notify("Could not show the keyboard shortcuts", message)
    return 1


def sections_or_error():
    try:
        return build_sections(), None
    except dbus.exceptions.DBusException as error:
        return None, f"could not reach Konveyor on the session bus (is the effect enabled?): {error.get_dbus_message()}"


def show_viewer():
    if close_running():
        return 0
    sections, error = sections_or_error()
    if error:
        return fail(error, True)
    env = dict(os.environ, QT_WAYLAND_SHELL_INTEGRATION="layer-shell")
    try:
        process = subprocess.Popen([str(VIEWER), str(QML), json.dumps(sections)], env=env)
    except OSError as error:
        return fail(f"could not start {VIEWER}: {error.strerror}", True)
    PID_FILE.write_text(str(process.pid))
    code = process.wait()
    if PID_FILE.exists() and PID_FILE.read_text().strip() == str(process.pid):
        PID_FILE.unlink()
    return max(code, 0)


def main():
    arguments = sys.argv[1:]
    if arguments == ["--json"]:
        sections, error = sections_or_error()
        if error:
            return fail(error, False)
        json.dump(sections, sys.stdout)
        return 0
    if arguments:
        sys.stderr.write("usage: konveyor-cheatsheet [--json]\n")
        return 2
    if PORTAL_LAUNCHER.exists():
        try:
            return subprocess.run([str(PORTAL_LAUNCHER), "shortcuts"], check=False).returncode
        except OSError as error:
            return fail(f"could not start {PORTAL_LAUNCHER}: {error.strerror}", True)
    return show_viewer()

if __name__ == "__main__":
    sys.exit(main())
