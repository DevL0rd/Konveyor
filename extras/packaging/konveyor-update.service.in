[Unit]
Description=Finish the Konveyor update from the last system update
ConditionPathExists=%h/.local/state/konveyor/update-pending
After=graphical-session.target

[Service]
Type=oneshot
Environment=KONVEYOR_SOURCE_DIR=@SOURCE_DIR@
Environment=KONVEYOR_INSTALL_SUPPORT=/usr/lib/konveyor
ExecStart=/usr/lib/konveyor/install --finish-update

[Install]
WantedBy=graphical-session.target
