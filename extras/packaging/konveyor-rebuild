#!/usr/bin/env bash
set -uo pipefail

exec 1>&2
export HOME="${HOME:-/root}"
export PATH="${PATH:-/usr/local/sbin:/usr/local/bin:/usr/bin:/bin}"
SUPPORT=${KONVEYOR_INSTALL_SUPPORT:-/usr/lib/konveyor}
source "$SUPPORT/common.sh"
STATE_FILE=${KONVEYOR_SOURCE_STATE:-$KONVEYOR_STATE_DIR/source}

log() {
    printf 'konveyor: %s\n' "$*"
}

[[ -r $STATE_FILE ]] || exit 0
mapfile -t state <"$STATE_FILE"
source_dir="${state[0]:-}"
owner="${state[1]:-}"
[[ -n $source_dir && -n $owner ]] || exit 0
uid=$(id -u "$owner" 2>/dev/null) || exit 0
home=$(getent passwd "$owner" | cut -d: -f6)

as_source_owner() {
    runuser -u "$owner" -- env -i HOME="$home" USER="$owner" LOGNAME="$owner" PATH="$home/.local/bin:/usr/local/bin:/usr/bin:/bin" \
        LANG="${LANG:-C.UTF-8}" XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        "${KONVEYOR_GIT_ENV[@]}" "$@"
}

git_owner() {
    as_source_owner git -C "$source_dir" "$@"
}

if [[ ! -d $source_dir ]] || ! git_owner rev-parse --git-dir >/dev/null 2>&1; then
    log "source checkout $source_dir is gone or not a git repository, skipping"
    exit 0
fi

pull_updates() {
    git_owner rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1 || return 1
    if ! git_owner fetch --quiet; then
        log "could not fetch updates for $source_dir, skipping"
        return 1
    fi
    [[ $(git_owner rev-list --count 'HEAD..@{upstream}') -gt 0 ]] || return 1
    if [[ -n $(git_owner status --porcelain --untracked-files=no) ]]; then
        log "$source_dir has local changes, skipping the update"
        return 1
    fi
    if [[ $(git_owner rev-list --count '@{upstream}..HEAD') -gt 0 ]]; then
        log "$source_dir has local commits that aren't upstream, skipping the update"
        return 1
    fi
    git_owner merge --ff-only --quiet '@{upstream}' || return 1
    log "updated to $(git_owner rev-parse --short HEAD)"
}

if pull_updates || [[ $(system_fingerprint) != "$(cat "$KONVEYOR_BUILT_FOR" 2>/dev/null)" ]]; then
    if [[ $(kwin_headers_version) != "$(kwin_version)" ]]; then
        log "KWin $(kwin_version) and its development files $(kwin_headers_version) don't match yet, waiting for the update to finish"
        exit 0
    fi
    KONVEYOR_OWNER="$owner" KONVEYOR_SOURCE_DIR="$source_dir" KONVEYOR_INSTALL_SUPPORT="$SUPPORT" "$SUPPORT/install" --system-update
fi
