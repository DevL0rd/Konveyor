#!/usr/bin/env bash
set -euo pipefail

STATE_FILE=/usr/share/konveyor/source

if [[ ! -r $STATE_FILE ]]; then
    echo "konveyor: no recorded source checkout, skipping rebuild" >&2
    exit 0
fi

mapfile -t state <"$STATE_FILE"
source_dir="${state[0]}"
owner="${state[1]}"
build_dir="$source_dir/build-release"

if [[ ! -d $source_dir ]]; then
    echo "konveyor: source checkout $source_dir is gone, run install.sh from a fresh clone" >&2
    exit 0
fi

runuser -u "$owner" -- cmake --build "$build_dir"
cmake --install "$build_dir" >/dev/null
if [[ -x $source_dir/widgets/desktop-hider/desktop-containment ]]; then
    runuser -u "$owner" -- env HOME="$(getent passwd "$owner" | cut -d: -f6)" "$source_dir/widgets/desktop-hider/desktop-containment" install || true
fi
echo "konveyor: rebuilt for the new KWin and Plasma; log out and back in to load it"
