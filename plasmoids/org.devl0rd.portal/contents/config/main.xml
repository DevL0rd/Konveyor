        <entry name="tileSize" type="Int"><default>52</default></entry>
        <entry name="showRecentApps" type="Bool"><default>true</default></entry>
        <entry name="showRecentFiles" type="Bool"><default>true</default></entry>
        <entry name="showGames" type="Bool"><default>true</default></entry>
        <entry name="showFriends" type="Bool"><default>true</default></entry>
        <entry name="gamesView" type="String"><default>grid</default></entry>
        <entry name="gamesSort" type="String"><default>recent</default></entry>
        <entry name="gameCardSize" type="Int"><default>10</default></entry>
        <entry name="appsSort" type="String"><default>name</default></entry>
        <entry name="searchFiles" type="Bool"><default>true</default></entry>
