        <entry name="popupWidth" type="Int"><default>44</default></entry>
        <entry name="popupHeight" type="Int"><default>34</default></entry>
        <entry name="migratedFromPortal" type="Bool"><default>false</default></entry>
        <entry name="defaultCategory" type="String"><default></default></entry>
        <entry name="gamesViewMode" type="String"><default></default></entry>
        <entry name="gameCardWidth" type="Int"><default>0</default></entry>
        <entry name="appViewMode" type="String"><default></default></entry>
        <entry name="defaultSort" type="String"><default></default></entry>
        <entry name="learnedRanking" type="String"><default></default></entry>
        <entry name="searchOrder" type="String"><default>answer,apps,games,windows,settings,files,friends,commands,other</default></entry>
    </group>
</kcfg>
