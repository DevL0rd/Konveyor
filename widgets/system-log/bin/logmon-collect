#!/usr/bin/env python3
"""
Linux-Log-Monitor :: resident collector.

Follows the systemd journal (`journalctl -f -o json`) -- the single most
complete live log on a Linux box: it already absorbs the kernel ring buffer
(dmesg), every systemd unit's stdout/stderr, and anything sent via syslog. We
keep the last N entries in a ring buffer and mirror it to a tmpfs JSON file that
the Plasma widget reads in-process via XHR (no process spawned per poll).

Run as a systemd --user service:  logmon-collect --serve

Optional environment:
  LOGMON_MAX_LINES   ring-buffer size (default 600)
  LOGMON_JOURNAL_ARGS  extra args appended to journalctl (e.g. "_UID=1000")
"""
import json
import os
import sys
import time
import fcntl
import signal
import threading
import subprocess
from collections import deque

APP = "Linux-Log-Monitor"
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
CACHE_DIR = os.path.join(RUNTIME, APP)
CACHE = os.path.join(CACHE_DIR, "log.json")
LOCK = os.path.join(CACHE_DIR, "serve.lock")

MAX_LINES = int(os.environ.get("LOGMON_MAX_LINES", "2000"))  # >= widget's max live buffer
SEED = min(MAX_LINES, 500)          # lines shown immediately on start
FLUSH_INTERVAL = 0.1                # flush ~immediately on new lines (caps bursts to 10/s)
OUTPUT_FIELDS = "MESSAGE,PRIORITY,SYSLOG_IDENTIFIER,_COMM,_SYSTEMD_UNIT,UNIT,_TRANSPORT,_PID,SYSLOG_PID"
HEARTBEAT = 5.0                     # refresh `ts` even when idle (liveness)


def text(value, separator=", "):
    if isinstance(value, list):
        if all(isinstance(item, int) for item in value):
            return bytes(value).decode("utf-8", "replace")
        return separator.join(text(item, separator) for item in value)
    return str(value)


def parse(raw):
    """One journal JSON record -> compact dict, or None to skip."""
    raw = raw.strip()
    if not raw:
        return None
    try:
        j = json.loads(raw)
    except ValueError:
        return None

    msg = text(j.get("MESSAGE", ""), "\n")

    try:
        t = int(j.get("__REALTIME_TIMESTAMP", 0))      # microseconds, unique key
    except (TypeError, ValueError):
        t = 0
    priority = j.get("PRIORITY", 6)
    if isinstance(priority, list):
        priority = priority[0] if priority else 6
    try:
        p = int(priority)                               # 0 emerg .. 7 debug
    except (TypeError, ValueError):
        p = 6

    unit = text(j.get("_SYSTEMD_UNIT") or j.get("UNIT") or "")
    ident = text(j.get("SYSLOG_IDENTIFIER") or j.get("_COMM") or "")
    if not ident:
        if j.get("_TRANSPORT") == "kernel":
            ident = "kernel"
        else:
            ident = unit[:-8] if unit.endswith(".service") else (unit or "?")
    pid = text(j.get("_PID") or j.get("SYSLOG_PID") or "")

    return {"t": t, "p": p, "id": str(ident)[:40], "u": unit, "pid": str(pid), "m": msg}


def write_cache(lines, alive=True, error=None):
    payload = {"ts": time.time(), "alive": alive, "lines": lines}
    if error:
        payload["error"] = error
    tmp = CACHE + ".tmp"
    with open(tmp, "w") as f:
        f.write(json.dumps(payload, separators=(",", ":")))
    os.replace(tmp, CACHE)


def serve():
    os.makedirs(CACHE_DIR, exist_ok=True)

    # single instance: hold an exclusive lock for the life of the process
    lock_fd = open(LOCK, "w")
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.stderr.write("another logmon-collect --serve is already running\n")
        return 0

    cmd = ["journalctl", "-f", "-o", "json", "--all", "--output-fields=" + OUTPUT_FIELDS, "--no-pager", "-n", str(SEED)]
    extra = os.environ.get("LOGMON_JOURNAL_ARGS", "").split()
    if extra:
        cmd += extra

    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True, bufsize=1)
    except FileNotFoundError:
        write_cache([], alive=False, error="journalctl is not installed")
        sys.stderr.write("logmon-collect: journalctl is not installed\n")
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        while True:
            signal.pause()

    ring = deque(maxlen=MAX_LINES)
    state = {"dead": False}
    changed = threading.Event()

    def reader():
        for raw in proc.stdout:
            rec = parse(raw)
            if rec is not None:
                ring.append(rec)
                changed.set()
        state["dead"] = True
        changed.set()

    t = threading.Thread(target=reader, daemon=True)
    t.start()

    def shutdown(*_):
        try:
            proc.terminate()
        except Exception:
            pass
        sys.exit(0)
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    write_cache(list(ring))
    last = time.monotonic()
    while True:
        if changed.wait(max(0.0, HEARTBEAT - (time.monotonic() - last))):
            since = time.monotonic() - last
            if since < FLUSH_INTERVAL:
                time.sleep(FLUSH_INTERVAL - since)
            changed.clear()
        if state["dead"]:
            write_cache(list(ring), alive=False)
            sys.stderr.write(f"logmon-collect: journalctl exited with status {proc.wait()}\n")
            return 1
        write_cache(list(ring))
        last = time.monotonic()


def main():
    if "--serve" in sys.argv[1:]:
        sys.exit(serve())
    sys.stderr.write(__doc__)
    sys.exit(2)


if __name__ == "__main__":
    main()
