#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 DevL0rd <dmhzmxn@gmail.com>
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

readonly SERVICE=org.kde.KWin
readonly OBJECT=/VirtualKeyboard
readonly INTERFACE=org.kde.kwin.VirtualKeyboard
readonly RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/linux-plasma-keyboard-toggle"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/linux-plasma-keyboard-toggle"
readonly SAVED_MODE="$STATE_DIR/mode"
readonly WATCHER_PID="$RUNTIME_DIR/watcher.pid"

property() {
    busctl --user get-property "$SERVICE" "$OBJECT" "$INTERFACE" "$1" | cut -d' ' -f2
}

set_property() {
    busctl --user set-property "$SERVICE" "$OBJECT" "$INTERFACE" "$1" "$2" "$3"
}

restore_mode() {
    if [[ -f $SAVED_MODE ]]; then
        set_property mode i "$(<"$SAVED_MODE")"
        rm -f "$SAVED_MODE"
    fi
}

restore_when_hidden() {
    coproc MONITOR { exec gdbus monitor --session --dest "$SERVICE" --object-path "$OBJECT"; }
    while read -r line <&"${MONITOR[0]}"; do
        [[ $line == *"$INTERFACE.visibleChanged"* ]] || continue
        [[ -f $SAVED_MODE ]] || break
        if [[ $(property visible) == false ]]; then
            restore_mode
            break
        fi
    done
    kill "$MONITOR_PID" 2>/dev/null || true
    rm -f "$WATCHER_PID"
}

start_watcher() {
    if [[ -f $WATCHER_PID ]] && kill -0 "$(<"$WATCHER_PID")" 2>/dev/null; then
        return
    fi
    setsid "$0" watch >/dev/null 2>&1 < /dev/null &
    printf '%s\n' "$!" >"$WATCHER_PID"
}

open_keyboard() {
    mkdir -p "$STATE_DIR" "$RUNTIME_DIR"
    local mode
    mode=$(property mode)
    [[ -f $SAVED_MODE ]] || printf '%s\n' "$mode" >"$SAVED_MODE"
    [[ $mode == 0 ]] && set_property mode i 1
    set_property active b true
    busctl --user call "$SERVICE" "$OBJECT" "$INTERFACE" forceActivate
    start_watcher
    printf 'open\n'
}

close_keyboard() {
    set_property active b false
    restore_mode
    sleep 0.3
    if [[ $(property visible) == true ]]; then
        pkill -x plasma-keyboard || true
    fi
    printf 'closed\n'
}

restart_keyboard() {
    mkdir -p "$RUNTIME_DIR"
    exec 9>"$RUNTIME_DIR/restart.lock"
    flock -n 9 || return 0
    local pid
    pid=$(pgrep -xo plasma-keyboard) || return 0
    (($(ps -o etimes= -p "$pid") >= 2)) || return 0
    kill "$pid"
    printf 'restarted\n'
}

case "${1:-toggle}" in
open) open_keyboard ;;
watch) restore_when_hidden ;;
close) close_keyboard ;;
restart) restart_keyboard ;;
state) [[ $(property visible) == true ]] && printf 'open\n' || printf 'closed\n' ;;
toggle)
    if [[ $(property visible) == true ]]; then
        close_keyboard
    else
        open_keyboard
    fi
    ;;
*)
    printf 'usage: linux-plasma-keyboard-toggle [toggle|open|close|restart|state]\n' >&2
    exit 2
    ;;
esac
