#!/usr/bin/env bash
set -uo pipefail

HIDER_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CONTAINMENT_PATH="plasma/plasmoids/org.kde.desktopcontainment"
TARGET="$DATA_HOME/$CONTAINMENT_PATH"
MARKER=".konveyor-managed"
LEGACY_MARKER=".linux-widget-hider-managed"
LEGACY_SCRIPT="$DATA_HOME/kwin/scripts/devl0rd-hide-desktop-widgets"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

note() {
    printf '\033[1;34m==>\033[0m %s\n' "$*"
}

managed() {
    [[ -f $TARGET/$MARKER || -f $TARGET/$LEGACY_MARKER ]]
}

remove_legacy_hider() {
    if [[ -f $LEGACY_SCRIPT/$LEGACY_MARKER ]]; then
        rm -rf "$LEGACY_SCRIPT"
    fi
    kwriteconfig6 --file kwinrc --group Plugins --key devl0rd-hide-desktop-widgetsEnabled --delete 2>/dev/null || true
    rm -f "$CONFIG_HOME/systemd/user/plasma-plasmashell.service.d/linux-widget-hider.conf" "$CONFIG_HOME/environment.d/linux-widget-hider.conf"
}

system_containment() {
    local directory directories
    IFS=: read -r -a directories <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    for directory in "${directories[@]}"; do
        if [[ -n $directory && -d $directory/$CONTAINMENT_PATH ]]; then
            printf '%s\n' "$directory/$CONTAINMENT_PATH"
            return 0
        fi
    done
    return 1
}

install_containment() {
    remove_legacy_hider
    if [[ -e $TARGET ]] && ! managed; then
        note "Skipping desktop widget hiding: $TARGET is someone else's override"
        return 0
    fi
    local system
    if ! system=$(system_containment); then
        note "Skipping desktop widget hiding: Plasma's desktop containment isn't in any of ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
        return 0
    fi
    local staging
    staging=$(mktemp -d)
    cp -a "$system" "$staging/org.kde.desktopcontainment"
    if ! GIT_CEILING_DIRECTORIES="$staging" git -C "$staging/org.kde.desktopcontainment" apply -p1 <"$HIDER_DIR/patches/desktopcontainment.patch" >/dev/null 2>&1; then
        rm -rf "$staging"
        managed && rm -rf "$TARGET"
        note "Skipping desktop widget hiding: this Plasma version's desktop containment doesn't take the patch"
        return 0
    fi
    touch "$staging/org.kde.desktopcontainment/$MARKER"
    mkdir -p "$(dirname "$TARGET")"
    rm -rf "$TARGET"
    mv "$staging/org.kde.desktopcontainment" "$TARGET"
    rm -rf "$staging"
    note "Desktop widgets can now hide while windows cover the desktop"
}

remove_hide_setting() {
    local applets="$CONFIG_HOME/plasma-org.kde.plasma.desktop-appletsrc" id
    [[ -f $applets ]] || return 0
    for id in $(sed -n 's/^\[Containments\]\[\([0-9]*\)\]\[General\]$/\1/p' "$applets"); do
        kwriteconfig6 --file "$applets" --group Containments --group "$id" --group General --key hideDesktopWidgets --delete
    done
}

uninstall_containment() {
    remove_legacy_hider
    remove_hide_setting
    managed && rm -rf "$TARGET"
    return 0
}

case "${1:-}" in
install) install_containment ;;
uninstall) uninstall_containment ;;
*)
    printf 'usage: desktop-containment install|uninstall\n' >&2
    exit 2
    ;;
esac
