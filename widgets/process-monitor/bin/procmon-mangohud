#!/usr/bin/env python3
import glob
import json
import os
import shutil
import sys

APP = "Linux-Process-Mon"
CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
MANGOHUD_CONF = os.path.join(CONFIG_HOME, "MangoHud", "MangoHud.conf")
BACKUP = os.path.join(CONFIG_HOME, APP, "mangohud-backup.json")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
LAYER_DIRS = [
    "/usr/share/vulkan/implicit_layer.d",
    "/etc/vulkan/implicit_layer.d",
    os.path.expanduser("~/.local/share/vulkan/implicit_layer.d"),
]


def wanted_settings():
    return {
        "control": "mangohud-%p",
        "log_duration": "0",
        "log_interval": "500",
        "output_folder": os.path.join(RUNTIME, APP, "mangohud"),
    }


def mangohud_installed():
    if shutil.which("mangohud"):
        return True
    return any(glob.glob(os.path.join(d, "*[Mm]ango[Hh]ud*.json")) for d in LAYER_DIRS)


def key_of(line):
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        return None
    return stripped.split("=", 1)[0].strip()


def read_lines():
    try:
        with open(MANGOHUD_CONF) as f:
            return f.read().splitlines()
    except FileNotFoundError:
        return []


def write_lines(lines):
    os.makedirs(os.path.dirname(MANGOHUD_CONF), exist_ok=True)
    tmp = MANGOHUD_CONF + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(tmp, MANGOHUD_CONF)


def apply(lines, settings):
    remaining = dict(settings)
    out = []
    for line in lines:
        key = key_of(line)
        if key in settings:
            if key in remaining:
                value = remaining.pop(key)
                if value is not None:
                    out.append(f"{key}={value}")
            continue
        out.append(line)
    for key, value in remaining.items():
        if value is not None:
            out.append(f"{key}={value}")
    return out


def current_values(lines, keys):
    values = {key: None for key in keys}
    for line in lines:
        key = key_of(line)
        if key in values:
            values[key] = line.strip().split("=", 1)[1].strip() if "=" in line else ""
    return values


def configure():
    if not mangohud_installed():
        print("MangoHud is not installed; FPS will not be shown.")
        return 0
    settings = wanted_settings()
    lines = read_lines()
    if not os.path.exists(BACKUP):
        os.makedirs(os.path.dirname(BACKUP), exist_ok=True)
        with open(BACKUP, "w") as f:
            json.dump(current_values(lines, settings.keys()), f, indent=2)
    write_lines(apply(lines, settings))
    print(f"Configured MangoHud to report FPS ({MANGOHUD_CONF}).")
    return 0


def restore():
    try:
        with open(BACKUP) as f:
            previous = json.load(f)
    except FileNotFoundError:
        return 0
    lines = read_lines()
    if lines:
        write_lines(apply(lines, previous))
    os.remove(BACKUP)
    print(f"Restored your previous MangoHud settings ({MANGOHUD_CONF}).")
    return 0


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command == "--configure":
        return configure()
    if command == "--restore":
        return restore()
    print("usage: procmon-mangohud --configure | --restore", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
