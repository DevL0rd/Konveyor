#!/usr/bin/env python3
import os, sys, json, time, resource

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [HERE, os.path.join(os.path.dirname(os.path.dirname(HERE)), "shared")]

import collectors
import procmon_gpu as graphics
import procmon_icons as icons
import procmon_proc as proc

try:
    _soft, _hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    if _soft < _hard:
        resource.setrlimit(resource.RLIMIT_NOFILE, (_hard, _hard))
except (ValueError, OSError):
    pass

APP = "Linux-Process-Mon"
RUNDIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), APP)
DATA = os.path.join(RUNDIR, "data.json")
PANEL_DIR = os.path.join(RUNDIR, "panel")
PANEL = os.path.join(PANEL_DIR, "panel.json")
FOCUS = os.path.join(RUNDIR, "focus")
PIDFILE = os.path.join(RUNDIR, "serve.pid")
NAME = "procmon-collect"
CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
CONFIG = os.path.join(CONFIG_HOME, APP, "config.json")

CLK = os.sysconf("SC_CLK_TCK")
NCPU = os.cpu_count() or 1

MEM_TOTAL = 0
try:
    for _ln in open("/proc/meminfo"):
        if _ln.startswith("MemTotal:"):
            MEM_TOTAL = int(_ln.split()[1]) * 1024
            break
except OSError:
    pass

SUM_KEYS = ["cpu", "ram", "gpu", "dec", "enc", "vram", "disk", "threads"]
_OMIT0 = SUM_KEYS + ["a" + k for k in SUM_KEYS]


def report(message):
    sys.stderr.write(f"{NAME}: {message}\n")


_poll_interval = 0.5

_prev = {"t": {}, "io": {}, "when": None}
_row_cache = {}
_KEYS = ("cpu", "ram", "threads", "gpu", "enc", "dec", "vram", "disk")
_AKEYS = tuple("a" + key for key in _KEYS)


def _base_row(pid, comm, ppid, own):
    row = {"pid": pid, "ppid": ppid, "name": comm}
    icon = icons.resolve_icon(comm)
    if icon:
        row["icon"] = icon
    for key, value in zip(_KEYS, own):
        if value:
            row[key] = value
    if pid == 2 or ppid == 2:
        row["kernel"] = True
    return row


def build():
    now = time.time()
    tick = time.monotonic()
    if icons.refresh_icon_map(tick):
        _row_cache.clear()
    procs, stat_changed = proc.read_procs()
    io, io_changed = proc.read_io(procs)
    gpu = graphics.gpu_usage(_poll_interval)
    frames = graphics.frame_rates()
    when = _prev["when"]
    dt = (tick - when) if when is not None else 0
    pt, pio = _prev["t"], _prev["io"]
    cpu_scale = 100.0 / CLK / dt / NCPU if dt > 0 else 0.0
    disk_scale = 1.0 / dt if dt > 0 else 0.0
    previous_rows = _row_cache
    previous_get = previous_rows.get
    gpu_get = gpu.get
    frame_get = frames.get
    cached_rows = {}
    ticks = {}
    totals = {}
    rows = {}
    kids = {}
    kids_get = kids.get
    for pid, (comm, ppid, t, rss, threads, _start) in procs.items():
        ticks[pid] = t
        cached = previous_get(pid)
        g = gpu_get(pid) if gpu else None
        frame = frame_get(pid) if frames else None
        if cached is not None and g is None and frame is None and pid not in stat_changed and pid not in io_changed:
            cached_rows[pid] = cached
            row = dict(cached[0])
            own = cached[1][:]
        else:
            prev_t = pt.get(pid)
            cpu = round(max(0.0, (t - prev_t) * cpu_scale), 1) if prev_t is not None else 0.0
            cur_io = io.get(pid)
            prev_io = pio.get(pid)
            disk = round(max(0.0, (cur_io - prev_io) * disk_scale)) if cur_io is not None and prev_io is not None else 0
            own = [cpu, rss, threads, g["gpu"], g["enc"], g["dec"], g["vram"], disk] if g else [cpu, rss, threads, 0, 0, 0, 0, disk]
            base = _base_row(pid, comm, ppid, own)
            if frame:
                base.update(frame)
            if g is None and frame is None and cpu == 0.0 and disk == 0:
                cached_rows[pid] = (base, own[:])
            row = dict(base)
        rows[pid] = row
        totals[pid] = own
        children = kids_get(ppid)
        if children is None:
            kids[ppid] = [pid]
        else:
            children.append(pid)
    previous_rows.clear()
    previous_rows.update(cached_rows)
    aggregate(procs, kids, totals)
    for pid, row in rows.items():
        total = totals[pid]
        if total[0]:
            total[0] = round(total[0], 1)
        for key, value in zip(_AKEYS, total):
            if value:
                row[key] = value
    _prev["t"] = ticks
    _prev["io"] = io
    _prev["when"] = tick
    focus_pid = _read_focus()
    focused = rows.get(focus_pid)
    if focused is not None:
        focused["name"], focused["icon"] = icons.process_identity(
            focus_pid, _panel["focus_name"] or focused["name"], focused.get("icon", ""))
    snap = {"ts": now, "ncpu": NCPU, "mem_total": MEM_TOTAL,
            "vram_total": graphics.vram_total(), "procs": list(rows.values())}
    _panel["rows"] = rows
    _panel["totals"] = totals
    return snap


_panel = {"rows": {}, "totals": {}, "focus": 0, "focus_name": "", "focus_stamp": None, "sig": None}


def _bytes_text(b):
    if b >= 1099511627776:
        return "%.1fT" % (b / 1099511627776)
    if b >= 1073741824:
        return "%.1fG" % (b / 1073741824)
    if b >= 1048576:
        return "%dM" % round(b / 1048576)
    if b >= 1024:
        return "%dK" % round(b / 1024)
    return "%dB" % round(b)


def _read_focus():
    try:
        stamp = os.stat(FOCUS).st_mtime_ns
    except OSError:
        return 0
    if stamp != _panel["focus_stamp"]:
        _panel["focus_stamp"] = stamp
        try:
            with open(FOCUS) as f:
                parts = f.read().splitlines()
            _panel["focus"] = int(parts[0].strip() or 0)
            _panel["focus_name"] = parts[1].strip() if len(parts) > 1 else ""
        except (OSError, ValueError):
            _panel["focus"] = 0
            _panel["focus_name"] = ""
    return _panel["focus"]


def panel_snapshot(snap):
    rows = _panel["rows"]
    totals = _panel["totals"]
    cpu = gpu = vram = 0
    gpu_top = None
    for row in snap["procs"]:
        cpu += row.get("cpu", 0)
        g = row.get("gpu", 0)
        gpu += g
        vram += row.get("vram", 0)
        if g > 0 and (gpu_top is None or g > gpu_top["gpu"]):
            gpu_top = {"pid": row["pid"], "name": row["name"], "gpu": g}
    summary = {"count": len(snap["procs"]), "cpu": min(100, cpu), "gpu": min(100, gpu), "vram": vram,
               "memTotal": snap["mem_total"], "vramTotal": snap["vram_total"], "ncpu": snap["ncpu"], "gpuTop": gpu_top}
    focus = None
    pid = _read_focus()
    row = rows.get(pid) if pid else None
    if row is not None:
        best = None
        for other in rows.values():
            if "fps" not in other:
                continue
            current, steps = other, 0
            while current is not None and steps < 64:
                if current["pid"] == pid:
                    if best is None or other["fps"] > best["fps"]:
                        best = other
                    break
                current = rows.get(current["ppid"]) if current["ppid"] > 0 else None
                steps += 1
        total = totals.get(pid, [0] * 8)
        parent = rows.get(row["ppid"]) if row["ppid"] > 0 else None
        focus = {"pid": pid, "ppid": row["ppid"], "name": row["name"], "icon": row.get("icon", ""),
                 "parentName": parent["name"] if parent else "",
                 "cpu": round(total[0], 1), "gpu": total[3], "ram": total[1], "vram": total[6], "disk": total[7],
                 "threads": total[2], "enc": total[4], "dec": total[5],
                 "fps": best["fps"] if best else -1, "frametime": best["frametime"] if best else 0,
                 "fpsLow": best["fps_low"] if best else 0, "framePid": best["pid"] if best else pid}
    if focus is None:
        sig = ("-", summary["count"], round(summary["cpu"]), round(summary["gpu"]))
    else:
        sig = (focus["pid"], focus["name"], focus["icon"], focus["parentName"], round(focus["cpu"]), round(focus["gpu"]),
               _bytes_text(focus["vram"]), _bytes_text(focus["ram"]), focus["fps"], "%.1f" % focus["frametime"], focus["fpsLow"])
    if sig == _panel["sig"]:
        return
    _panel["sig"] = sig
    os.makedirs(PANEL_DIR, exist_ok=True)
    tmp = PANEL + ".tmp"
    with open(tmp, "w") as f:
        f.write(json.dumps({"focus": focus, "summary": summary}, separators=(",", ":")))
    os.replace(tmp, PANEL)


def aggregate(procs, kids, totals):
    order = []
    seen = set()
    stack = [pid for pid, p in procs.items() if p[1] not in procs]
    while stack:
        pid = stack.pop()
        if pid in seen:
            continue
        seen.add(pid)
        order.append(pid)
        children = kids.get(pid)
        if children:
            stack.extend(children)
    for pid in reversed(order):
        ppid = procs[pid][1]
        if ppid in seen:
            parent = totals[ppid]
            own = totals[pid]
            parent[0] += own[0]; parent[1] += own[1]; parent[2] += own[2]; parent[3] += own[3]
            parent[4] += own[4]; parent[5] += own[5]; parent[6] += own[6]; parent[7] += own[7]


def write_snapshot(snap):
    os.makedirs(RUNDIR, exist_ok=True)
    tmp = DATA + ".tmp"
    with open(tmp, "w") as f:
        f.write(json.dumps(snap, separators=(",", ":")))
    os.replace(tmp, DATA)


def cmd_restart():
    return collectors.restart(PIDFILE, NAME)


def tick(interval):
    global _poll_interval
    _poll_interval = interval
    snap = build()
    write_snapshot(snap)
    panel_snapshot(snap)


def cmd_serve():
    collectors.write_pidfile(PIDFILE)
    build()
    time.sleep(0.5)
    snap = build()
    write_snapshot(snap)
    panel_snapshot(snap)
    collectors.serve(CONFIG, 0.5, tick, report)


def cmd_set_interval():
    return collectors.set_interval(CONFIG, sys.argv[2] if len(sys.argv) > 2 else None)


def cmd_once():
    build()
    time.sleep(0.4)
    sys.stdout.write(json.dumps(build(), separators=(",", ":")))
    sys.stdout.write("\n")


def cmd_snapshot():
    try:
        sys.stdout.write(open(DATA).read())
    except Exception:
        sys.stdout.write('{"ts":0,"ncpu":1,"procs":[]}')


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "--once"
    command = {"--serve": cmd_serve, "--snapshot": cmd_snapshot, "--restart": cmd_restart,
               "--set-interval": cmd_set_interval, "--once": cmd_once}.get(arg)
    if command is None:
        sys.stderr.write("usage: procmon-collect [--serve | --snapshot | --once | --restart | --set-interval SECONDS]\n")
        return 2
    return command()


if __name__ == "__main__":
    sys.exit(main() or 0)
