#!/usr/bin/env python3
"""
Linux-Process-Mon :: resident process collector.

A single `--serve` daemon (systemd --user service, pinned to the E-cores) reads
/proc once per interval and writes a compact process snapshot to
$XDG_RUNTIME_DIR/Linux-Process-Mon/data.json. The widget reads that file
in-process via XHR (no per-poll process spawn), builds the parent/child tree and
renders the table.

Per row: name, ppid (for the tree), CPU% (per-core, htop-style), RSS bytes,
thread count, PID, disk I/O (bytes/s, own processes only -- /proc/<pid>/io is
not readable for other users without root), and the NVIDIA per-process figures
from `nvidia-smi pmon`: GPU (SM) %, encoder %, decoder %, VRAM bytes.

Summable metrics also get an a* field = self + every descendant (subtree total).

Modes:
  procmon-collect --serve      resident: refresh the snapshot every interval
  procmon-collect --snapshot   print the cached snapshot (debug / fallback)
  procmon-collect --once       one sample to stdout (debug)
"""
import os, sys, json, time, glob, socket

APP = "Linux-Process-Mon"
RUNDIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), APP)
DATA = os.path.join(RUNDIR, "data.json")
CONFIG = os.path.expanduser(f"~/.config/{APP}/config.json")
MANGO_DIR = os.path.join(RUNDIR, "mangohud")

CLK = os.sysconf("SC_CLK_TCK")
PAGE = os.sysconf("SC_PAGE_SIZE")
NCPU = os.cpu_count() or 1

MEM_TOTAL = 0
try:
    for _ln in open("/proc/meminfo"):
        if _ln.startswith("MemTotal:"):
            MEM_TOTAL = int(_ln.split()[1]) * 1024          # kB -> bytes
            break
except OSError:
    pass

# metrics aggregated up the tree (self + descendants); pid/ppid are not summed
SUM_KEYS = ["cpu", "ram", "gpu", "dec", "enc", "vram", "disk", "threads"]
# metric fields dropped from the JSON when zero (the widget defaults them back to
# 0) -- shrinks the snapshot a lot since most processes are idle on most metrics
_OMIT0 = SUM_KEYS + ["a" + k for k in SUM_KEYS]


# ---- process -> icon resolution (from the .desktop database, cached) ----
DESKTOP_DIRS = [
    "/usr/share/applications", "/usr/local/share/applications",
    os.path.expanduser("~/.local/share/applications"),
    "/var/lib/flatpak/exports/share/applications",
    os.path.expanduser("~/.local/share/flatpak/exports/share/applications"),
]
# branded apps whose process name doesn't match any .desktop key
ICON_ALIASES = {
    "chrome": "google-chrome", "chromium": "chromium", "msedge": "microsoft-edge",
    "brave": "brave-browser", "code-oss": "code-oss", "codium": "vscodium",
    "firefox-bin": "firefox", "thunderbird-bin": "thunderbird",
    "steamwebhelper": "steam", "wineserver": "wine", "telegram-desktop": "telegram",
}
_EXEC_SKIP = {"env", "flatpak", "sh", "bash", "run", "--", "gtk-launch"}
# generic runtimes/interpreters: the comm doesn't identify the app, so a .desktop
# match would be a coincidence (python3 -> some random app's icon). Skip them.
GENERIC_COMMS = {
    "python", "python2", "python3", "node", "nodejs", "java", "electron",
    "sh", "bash", "dash", "zsh", "fish", "perl", "ruby", "mono", "dotnet",
    "wrapper", "lua", "php", "deno", "bun",
}

_icon_map = None
_icon_map_when = 0.0
_icon_resolved = {}                                        # comm -> icon name (cache)


def _parse_desktop(path):
    icon = exe = tryexe = wm = ""
    in_entry = False
    try:
        for ln in open(path, encoding="utf-8", errors="ignore"):
            ln = ln.strip()
            if ln.startswith("["):
                in_entry = (ln == "[Desktop Entry]")
                continue
            if not in_entry or "=" not in ln:
                continue
            k, _, v = ln.partition("=")
            v = v.strip()
            if k == "Icon" and not icon: icon = v
            elif k == "Exec" and not exe: exe = v
            elif k == "TryExec" and not tryexe: tryexe = v
            elif k == "StartupWMClass" and not wm: wm = v
    except OSError:
        return None
    return icon, exe, tryexe, wm


def _exec_basename(exe):
    for t in exe.split():
        if not t or t.startswith("%") or t.startswith("-") or "=" in t.split("/")[0]:
            continue
        b = os.path.basename(t)
        if b and b not in _EXEC_SKIP:
            return b
    return ""


def build_icon_map():
    m = {}
    for d in DESKTOP_DIRS:
        for path in glob.glob(os.path.join(d, "*.desktop")):
            r = _parse_desktop(path)
            if not r or not r[0]:
                continue
            icon, exe, tryexe, wm = r
            keys = {os.path.basename(path)[:-8].lower()}   # file stem
            if exe:
                b = _exec_basename(exe)
                if b: keys.add(b.lower())
            if tryexe:
                keys.add(os.path.basename(tryexe).lower())
            if wm:
                keys.add(wm.lower())
            for k in keys:
                m.setdefault(k, icon)
    return m


def resolve_icon(comm):
    global _icon_map, _icon_map_when
    now = time.time()
    if _icon_map is None or now - _icon_map_when > 300:     # rescan occasionally
        _icon_map = build_icon_map(); _icon_map_when = now; _icon_resolved.clear()
    if comm in _icon_resolved:
        return _icon_resolved[comm]
    c = comm.lower()
    icon = ICON_ALIASES.get(c) or ("" if c in GENERIC_COMMS else _icon_map.get(c, "")) or ""
    _icon_resolved[comm] = icon
    return icon


def load_config():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except Exception:
        return {}


_O_RDONLY = os.O_RDONLY
_io_denied = {}
_stat_cache = {}
_io_cache = {}


def read_procs():
    """pid -> (comm, ppid, cpu ticks, rss bytes, threads, starttime)."""
    out = {}
    parsed = {}
    previous = _stat_cache
    open_file, read_file, close_file = os.open, os.read, os.close
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        try:
            fd = open_file("/proc/" + name + "/stat", _O_RDONLY)
        except OSError:
            continue
        try:
            line = read_file(fd, 1024)
        except OSError:
            continue
        finally:
            close_file(fd)
        pid = int(name)
        cached = previous.get(pid)
        if cached is not None and cached[0] == line:
            parsed[pid] = cached
            out[pid] = cached[1]
            continue
        r = line.rfind(b")")
        rest = line[r + 2:].split(None, 22)
        if len(rest) < 22:
            continue
        values = (line[line.find(b"(") + 1:r].decode(errors="replace"), int(rest[1]),
                  int(rest[11]) + int(rest[12]), int(rest[21]) * PAGE, int(rest[17]), rest[19])
        parsed[pid] = (line, values)
        out[pid] = values
    _stat_cache.clear()
    _stat_cache.update(parsed)
    return out


def read_io(procs):
    """pid -> cumulative read+write bytes (own processes only; others are skipped
    once denied, until the pid is reused)."""
    out = {}
    denied = _io_denied
    still = {}
    previous = _io_cache
    parsed = {}
    open_file, read_file, close_file = os.open, os.read, os.close
    for pid, p in procs.items():
        start = p[5]
        if denied.get(pid) == start:
            still[pid] = start
            continue
        try:
            fd = open_file("/proc/" + str(pid) + "/io", _O_RDONLY)
        except PermissionError:
            still[pid] = start
            continue
        except OSError:
            continue
        try:
            data = read_file(fd, 512)
        except OSError:
            continue
        finally:
            close_file(fd)
        cached = previous.get(pid)
        if cached is not None and cached[0] == data:
            parsed[pid] = cached
            out[pid] = cached[1]
            continue
        rb = data.find(b"read_bytes:")
        wb = data.find(b"write_bytes:", rb)
        if rb < 0 or wb < 0:
            continue
        total = int(data[rb + 11:data.find(b"\n", rb)]) + int(data[wb + 12:data.find(b"\n", wb)])
        parsed[pid] = (data, total)
        out[pid] = total
    denied.clear()
    denied.update(still)
    _io_cache.clear()
    _io_cache.update(parsed)
    return out


# current GPU poll interval (seconds); cmd_serve keeps this fresh. Used only to
# size the per-process utilization look-back so each poll reflects the activity
# since the previous one (NVIDIA gives samples, not an instantaneous figure).
_poll_interval = 2.0

_nvml = {"init": False, "h": None, "vram_total": 0}


def vram_total():
    """Total VRAM bytes via NVML (cached); 0 when no NVIDIA/NVML."""
    if _nvml["vram_total"]:
        return _nvml["vram_total"]
    try:
        import pynvml as N
        if not _nvml["init"]:
            N.nvmlInit()
            _nvml["h"] = N.nvmlDeviceGetHandleByIndex(0)
            _nvml["init"] = True
        _nvml["vram_total"] = N.nvmlDeviceGetMemoryInfo(_nvml["h"]).total
    except Exception:
        pass
    return _nvml["vram_total"]


def gpu_usage():
    """pid -> {gpu, enc, dec (%), vram (bytes)} via NVML -- no fork, ~4ms. NVIDIA's
    per-process utilization is sample-based (there is no instantaneous figure), so
    each poll reports the samples in the look-back window ending now -- newest per
    pid. No cross-poll state: a process that didn't touch the GPU in that window
    reads 0, like the /proc metrics. Empty when no NVIDIA GPU / NVML present."""
    try:
        import pynvml as N
    except Exception:
        return {}
    try:
        if not _nvml["init"]:
            N.nvmlInit()
            _nvml["h"] = N.nvmlDeviceGetHandleByIndex(0)
            _nvml["init"] = True
        h = _nvml["h"]
        # cover the gap since the previous poll (+ margin for NVML's sampling jitter)
        # so nothing active is missed; timeStamp is unix microseconds.
        since = int((time.time() - max(1.0, _poll_interval + 0.5)) * 1e6)
        latest = {}                                      # pid -> (ts, sm, enc, dec)
        try:
            for su in N.nvmlDeviceGetProcessUtilization(h, since):
                cur = latest.get(su.pid)
                if cur is None or su.timeStamp > cur[0]:
                    latest[su.pid] = (su.timeStamp, su.smUtil, su.encUtil, su.decUtil)
        except N.NVMLError:
            pass                                          # no samples in window -> all idle
        res = {}
        for p in (N.nvmlDeviceGetComputeRunningProcesses(h)
                  + N.nvmlDeviceGetGraphicsRunningProcesses(h)):
            s = latest.get(p.pid)
            res[p.pid] = {"gpu": s[1] if s else 0, "enc": s[2] if s else 0,
                          "dec": s[3] if s else 0, "vram": (p.usedGpuMemory or 0)}
        for pid, s in latest.items():                    # active but no VRAM-residency entry
            if pid not in res:
                res[pid] = {"gpu": s[1], "enc": s[2], "dec": s[3], "vram": 0}
        return res
    except Exception:
        return {}


_fps = {"files": frozenset(), "owners": {}, "samples": {}, "logging": set()}
MANGOHUD_SOCKET_PREFIX = "@mangohud-"
FPS_STALE_SECONDS = 3
FPS_LOW_WINDOW_SECONDS = 30
ORPHAN_LOG_SECONDS = 10


def _log_owners(paths):
    owners = {}
    if not paths:
        return owners
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        fd_dir = f"/proc/{pid}/fd"
        try:
            fds = os.listdir(fd_dir)
        except OSError:
            continue
        for fd in fds:
            try:
                target = os.readlink(f"{fd_dir}/{fd}")
            except OSError:
                continue
            if target in paths:
                owners[target] = int(pid)
    return owners


def _last_frame(path):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 2048))
            chunk = f.read().decode(errors="replace")
    except OSError:
        return None
    for line in reversed(chunk.splitlines()):
        parts = line.split(",")
        if len(parts) < 16:
            continue
        try:
            return float(parts[0]), float(parts[1])
        except ValueError:
            continue
    return None


def _remove_orphan_logs(names, owners, now):
    for name in names:
        path = os.path.join(MANGO_DIR, name)
        log = path[:-len("_summary.csv")] + ".csv" if name.endswith("_summary.csv") else path
        if log in owners:
            continue
        try:
            if now - os.path.getmtime(path) > ORPHAN_LOG_SECONDS:
                os.remove(path)
        except OSError:
            continue


def _mangohud_pids():
    pids = set()
    try:
        with open("/proc/net/unix", "rb") as f:
            data = f.read()
    except OSError:
        return pids
    marker = MANGOHUD_SOCKET_PREFIX.encode()
    at = data.find(marker)
    while at >= 0:
        end = data.find(b"\n", at)
        digits = data[at + len(marker):end if end >= 0 else len(data)].strip()
        if digits.isdigit():
            pids.add(int(digits))
        at = data.find(marker, at + len(marker))
    return pids


MANGOHUD_SCAN_SECONDS = 2.0
_mangohud_scan = {"when": 0.0}


def start_mangohud_logging():
    now = time.monotonic()
    if now - _mangohud_scan["when"] < MANGOHUD_SCAN_SECONDS:
        return
    _mangohud_scan["when"] = now
    running = _mangohud_pids()
    started = _fps["logging"]
    started &= running
    for pid in running - started:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
                conn.settimeout(0.2)
                conn.connect("\0" + MANGOHUD_SOCKET_PREFIX[1:] + str(pid))
                conn.sendall(b":logging=1;")
            started.add(pid)
        except OSError:
            continue


def mangohud_frames(now):
    try:
        names = [n for n in os.listdir(MANGO_DIR) if n.endswith(".csv")]
    except OSError:
        return {}
    logs = frozenset(os.path.join(MANGO_DIR, n) for n in names if not n.endswith("_summary.csv"))
    owners = _fps["owners"]
    if logs != _fps["files"] or any(not os.path.exists(f"/proc/{pid}") for pid in owners.values()):
        owners = _log_owners(logs)
        _fps["files"] = logs
        _fps["owners"] = owners
    _remove_orphan_logs(names, owners, now)
    frames = {}
    samples = _fps["samples"]
    for path in list(samples):
        if path not in owners:
            del samples[path]
    for path, pid in owners.items():
        try:
            if now - os.path.getmtime(path) > FPS_STALE_SECONDS:
                continue
        except OSError:
            continue
        frame = _last_frame(path)
        if frame is None:
            continue
        fps, frametime = frame
        window = [(t, v) for t, v in samples.get(path, []) if now - t <= FPS_LOW_WINDOW_SECONDS]
        window.append((now, fps))
        samples[path] = window
        ordered = sorted(v for _, v in window)
        low = ordered[int(len(ordered) * 0.01)]
        frames[pid] = {"fps": round(fps), "frametime": round(frametime, 2), "fps_low": round(low)}
    return frames


_prev = {"t": {}, "io": {}, "when": None}
_KEYS = ("cpu", "ram", "threads", "gpu", "enc", "dec", "vram", "disk")
_AKEYS = tuple("a" + key for key in _KEYS)


def build():
    now = time.time()
    procs = read_procs()
    io = read_io(procs)
    gpu = gpu_usage()
    start_mangohud_logging()
    frames = mangohud_frames(now)
    when = _prev["when"]
    dt = (now - when) if when else 0
    pt, pio = _prev["t"], _prev["io"]
    cpu_scale = 100.0 / CLK / dt / NCPU if dt > 0 else 0.0
    disk_scale = 1.0 / dt if dt > 0 else 0.0
    ticks = {}
    totals = {}
    rows = {}
    kids = {}
    icon_for = resolve_icon
    for pid, (comm, ppid, t, rss, threads, _start) in procs.items():
        ticks[pid] = t
        prev_t = pt.get(pid)
        cpu = round(max(0.0, (t - prev_t) * cpu_scale), 1) if prev_t is not None else 0.0
        cur_io = io.get(pid)
        prev_io = pio.get(pid)
        disk = round(max(0.0, (cur_io - prev_io) * disk_scale)) if cur_io is not None and prev_io is not None else 0
        g = gpu.get(pid)
        own = [cpu, rss, threads, g["gpu"], g["enc"], g["dec"], g["vram"], disk] if g else [cpu, rss, threads, 0, 0, 0, 0, disk]
        row = {"pid": pid, "ppid": ppid, "name": comm}
        icon = icon_for(comm)
        if icon:
            row["icon"] = icon
        for key, value in zip(_KEYS, own):
            if value:
                row[key] = value
        if pid == 2 or ppid == 2:
            row["kernel"] = True
        frame = frames.get(pid)
        if frame:
            row.update(frame)
        rows[pid] = row
        totals[pid] = own
        children = kids.get(ppid)
        if children is None:
            kids[ppid] = [pid]
        else:
            children.append(pid)
    aggregate(procs, kids, totals)
    for pid, row in rows.items():
        total = totals[pid]
        if total[0]:
            total[0] = round(total[0], 1)
        for key, value in zip(_AKEYS, total):
            if value:
                row[key] = value
    _prev["t"] = ticks
    _prev["io"] = io
    _prev["when"] = now
    return {"ts": now, "ncpu": NCPU, "mem_total": MEM_TOTAL,
            "vram_total": vram_total(), "procs": list(rows.values())}


def aggregate(procs, kids, totals):
    """Turn each pid's own metrics into self + every descendant. RSS/VRAM sums
    overcount shared pages a little, but it's the useful 'whole subtree' number."""
    order = []
    seen = set()
    stack = [pid for pid, p in procs.items() if p[1] not in procs]
    while stack:
        pid = stack.pop()
        if pid in seen:
            continue
        seen.add(pid)
        order.append(pid)
        children = kids.get(pid)
        if children:
            stack.extend(children)
    for pid in reversed(order):
        ppid = procs[pid][1]
        if ppid in seen:
            parent = totals[ppid]
            own = totals[pid]
            parent[0] += own[0]; parent[1] += own[1]; parent[2] += own[2]; parent[3] += own[3]
            parent[4] += own[4]; parent[5] += own[5]; parent[6] += own[6]; parent[7] += own[7]


def write_snapshot(snap):
    os.makedirs(RUNDIR, exist_ok=True)
    tmp = DATA + ".tmp"
    with open(tmp, "w") as f:
        f.write(json.dumps(snap, separators=(",", ":")))
    os.replace(tmp, DATA)


def cmd_serve():
    os.makedirs(MANGO_DIR, exist_ok=True)
    build()                                                # prime CPU/disk deltas
    time.sleep(0.5)                                        # real delta before first write
    write_snapshot(build())
    last = time.time()
    global _poll_interval
    config_stamp = None
    interval = 2.0
    while True:
        try:
            stamp = os.stat(CONFIG).st_mtime_ns
        except OSError:
            stamp = 0
        if stamp != config_stamp:
            config_stamp = stamp
            interval = max(0.25, float(load_config().get("poll_interval", 2)))
        _poll_interval = interval                          # size the GPU look-back to it
        elapsed = time.time() - last
        if elapsed >= interval:
            last = time.time()
            try:
                write_snapshot(build())
            except Exception as e:
                sys.stderr.write(f"procmon-collect: {e}\n")
        else:
            time.sleep(min(0.2, interval - elapsed))


def cmd_set_interval():
    if len(sys.argv) < 3:
        return 1
    try:
        v = max(0.25, float(sys.argv[2]))
    except ValueError:
        return 1
    cfg = load_config()
    cfg["poll_interval"] = v
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG, "w") as f:
        json.dump(cfg, f, indent=2)
    return 0


def cmd_once():
    build()
    time.sleep(0.4)
    sys.stdout.write(json.dumps(build(), separators=(",", ":")))
    sys.stdout.write("\n")


def cmd_snapshot():
    try:
        sys.stdout.write(open(DATA).read())
    except Exception:
        sys.stdout.write('{"ts":0,"ncpu":1,"procs":[]}')


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "--once"
    return {"--serve": cmd_serve, "--snapshot": cmd_snapshot,
            "--set-interval": cmd_set_interval, "--once": cmd_once}.get(arg, cmd_once)()


if __name__ == "__main__":
    sys.exit(main() or 0)
